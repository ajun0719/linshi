    position: relative
}

.b-b:after,.b-t:after {
    border-bottom: 1px solid $border-color-base;
    content: "";
    height: 0;
    left: 0;
    position: absolute;
    right: 0;
    -webkit-transform: scaleY(.5);
    transform: scaleY(.5);
    z-index: 3
}

::-webkit-scrollbar {
    color: transparent;
    height: 0;
    width: 0
}

.b-b:after {
    bottom: 0
}

.b-t:after {
    top: 0
}

.overflow_1 {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap
}

.height100 {
    height: 100rpx
}

body::after {
    -webkit-animation: shadow-preload .1s;
    -webkit-animation-delay: 3s;
    animation: shadow-preload .1s;
    animation-delay: 3s;
    content: "";
    left: -1000px;
    position: fixed;
    top: -1000px
}

@-webkit-keyframes shadow-preload {
    0% {
        background-image: url(https://cdn1.dcloud.net.cn/515467354d5452445169556c6433677a4d4745335a4759314d5445314d445a6d4f44426b/img/shadow-grey.png)
    }

    100% {
        background-image: url(https://cdn1.dcloud.net.cn/515467354d5452445169556c6433677a4d4745335a4759314d5445314d445a6d4f44426b/img/shadow-grey.png)
    }
}

@keyframes shadow-preload {
    0% {
        background-image: url(https://cdn1.dcloud.net.cn/515467354d5452445169556c6433677a4d4745335a4759314d5445314d445a6d4f44426b/img/shadow-grey.png)
    }

    100% {
        background-image: url(https://cdn1.dcloud.net.cn/515467354d5452445169556c6433677a4d4745335a4759314d5445314d445a6d4f44426b/img/shadow-grey.png)
    }
}

