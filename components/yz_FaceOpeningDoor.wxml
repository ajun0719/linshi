<view class="{{[cd==1?'h100':'']}}">
    <view class="group-info" wx:if="{{cd>1}}">
        <view class="item-child">
            <view class="creater-info" data-index="{{index}}">{{item.PointName}}</view>
            <view class="{{[opening?'backfe3a20':'back16b2f0']}}" style="border-radius:10rpx;">
                <view bindtap="__e" class="lanyakaimen" data-event-opts="{{[ [ 'tap',[ [ 'openRenlianClick',['$event'] ] ] ] ]}}" data-index="{{index}}" data-item="{{item}}" wx:if="{{item.Cmd}}">
                    <view class="iconfont icon-open-door add-btn1"></view>
                    <view class="lanya">{{opening?'开门中':'远程开门'}}</view>
                </view>
                <view class="lanyakaimen unopen" wx:else>
                    <view class="iconfont icon-open-door add-btn1"></view>
                    <view class="lanya">远程开门</view>
                </view>
            </view>
        </view>
        <view class="item-view">
            <view class="detail-info">
                <view class="{{['child-info1',item.pdtime>14?'c6eea27':'cdb4444']}}" wx:if="{{item.Cmd}}">
                    <text>有效期: </text>
                    <text>{{item.day}}</text>
                    <text wx:if="{{item.pdtime<14&&item.pdtime>0}}">（即将到期）</text>
                </view>
                <view class="child-info1 expire" wx:else>{{'有效期: '+item.day+' (已过期)'}}</view>
            </view>
            <view style="width:90px;display:flex;justify-content:center;">
                <text bindtap="__e" class="tx-llmm" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}" data-item="{{item}}" wx:if="{{item.Cmd&&item.DisTempPW===0}}">临时密码</text>
            </view>
        </view>
    </view>
    <view class="yj" wx:if="{{cd==1}}">
        <view class="item-child PointName">
            <view class="creater-info1" style="font-size:40rpx;">{{item.PointName}}</view>
        </view>
        <view bindtap="__e" class="{{['lykm_title',opening?'bd81e06':'b00cca3']}}" data-event-opts="{{[ [ 'tap',[ [ 'openRenlianClick',['$event'] ] ] ] ]}}" data-index="{{index}}" data-item="{{item}}" wx:if="{{item.Cmd}}">
            <image class="lykm bfff" src="{{opening?'/static/images/yckm1.png':'/static/images/yckm.png'}}"></image>
            <text class="title1">一键开门</text>
        </view>
        <view class="lykm_title" wx:else>
            <image class="lykmNoCmd bfff" src="/static/images/lykm2.png"></image>
        </view>
        <view class="item-view1" style="margin-top:60rpx;">
            <view class="detail-info">
                <view class="{{['child-info',item.pdtime>14?'c6eea27':'cdb4444']}}" style="font-size:40rpx;" wx:if="{{item.Cmd}}">
                    <text>有效期: </text>
                    <text style="margin-left:10rpx;">{{item.day}}</text>
                    <text wx:if="{{item.pdtime<14&&item.pdtime>0}}">（即将到期）</text>
                </view>
                <view class="child-info expire" style="font-size:40rpx;" wx:else>{{'有效期: '+item.day+' (已过期)'}}</view>
            </view>
            <view style="display:flex;justify-content:center;font-size:44rpx;margin-top:60rpx;" wx:if="{{item.Cmd&&item.DisTempPW===0}}">
                <text bindtap="__e" class="mima" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}" data-item="{{item}}">点击显示临时密码</text>
            </view>
        </view>
    </view>
    <view catchtouchmove="true" class="modal" wx:if="{{visible}}">
        <view class="mask"></view>
        <view class="gopay_tip">
            <view class="title-view">
                <text class="tip_title">临时密码生成</text>
            </view>
            <view class="llmm-content-view">
                <text class="content_llmm" selectable="true">{{llmm?llmm:''}}</text>
            </view>
            <view wx:if="{{item.LockType==2}}">
                <view class="tishi" style="margin-left:40rpx;">点击屏幕下方按钮区域调出键盘界面，</view>
                <view class="tishi" style="margin-bottom:40rpx;">依次输入编号和密码。</view>
            </view>
            <view wx:if="{{item.LockType==5}}">
                <view class="tishi" style="margin-left:40rpx;">输入以上密码，点击“ok”按键</view>
            </view>
            <view class="btn-modal">
                <button bindtap="__e" class="tip_cancel" data-event-opts="{{[ [ 'tap',[ [ 'cancelLlmm',['$event'] ] ] ] ]}}">确定</button>
                <button bindtap="__e" class="tip_confirm" data-event-opts="{{[ [ 'tap',[ [ 'copyLlmm',['$event'] ] ] ] ]}}">复制密码</button>
            </view>
        </view>
    </view>
    <view catchtouchmove="true" class="modal" wx:if="{{RemoteFlag}}">
        <view class="mask"></view>
        <view class="gopay_tip">
            <view class="title-view">
                <text class="tip_title">提示</text>
            </view>
            <view class="llmm-content-view" style="display:flex;flex-direction:column;justify-content:center;">
                <text class="tip_content" space="emsp" style="text-align:center;margin-bottom:30rpx;">设备离线，远程开门不可用！</text>
                <text class="tip_content" space="emsp" style="font-size:30rpx;margin-left:40rpx;" wx:if="{{YZMima}}">您可以使用临时密码开门：</text>
                <text class="tip_content" space="emsp" style="font-size:30rpx;margin-left:40rpx;margin-bottom:20rpx;margin-top:10rpx;" wx:if="{{YZMima}}">点击屏幕左下方“人脸识别”区域，依次输入：【<text style="color:#db4444;">{{YZMima}}</text>】</text>
            </view>
            <view class="btn-modal">
                <button bindtap="__e" class="tip_cancel" data-event-opts="{{[ [ 'tap',[ [ 'YZcancelLlmm',['$event'] ] ] ] ]}}">确定</button>
                <button bindtap="__e" class="tip_confirm" data-event-opts="{{[ [ 'tap',[ [ 'copyLlmm',['$event'] ] ] ] ]}}" wx:if="{{YZMima}}">复制密码</button>
            </view>
        </view>
    </view>
</view>
