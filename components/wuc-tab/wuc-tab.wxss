._div,wx-scroll-view,wx-swiper {
    box-sizing: border-box
}

.wuc-tab {
    background: #fff;
    white-space: nowrap
}

.wuc-tab-item {
    color: #333;
    display: inline-block;
    font-size: 30rpx;
    font-weight: 700;
    height: 90rpx;
    line-height: 90rpx;
    margin: 0 10rpx;
    padding: 0 20rpx
}

.wuc-tab-item.cur {
    border-bottom: 4rpx solid
}

.wuc-tab.fixed {
    box-shadow: 0 1rpx 6rpx rgba(0,0,0,.1);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1024
}

.flex {
    display: -webkit-flex;
    display: flex
}

.text-center {
    text-align: center
}

.flex-sub {
    -webkit-flex: 1;
    flex: 1
}

.text-blue {
    color: #0081ff
}

.text-white {
    color: #fff
}
