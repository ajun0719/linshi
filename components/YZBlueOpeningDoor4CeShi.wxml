<view class="{{[cd==1?'h100':'']}}">
    <view class="group-info" wx:if="{{cd>1}}">
        <view class="item-child">
            <view class="creater-info">{{item.PointName}}</view>
            <view class="{{[opening?'backfe3a20':'back16b2f0']}}" style="border-radius:10rpx;">
                <view bindtap="__e" class="lanyakaimen" data-event-opts="{{[ [ 'tap',[ [ 'openDoor_FR',['$event'] ] ] ] ]}}" wx:if="{{item.Cmd}}">
                    <view class="iconfont icon-open-door add-btn1"></view>
                    <view class="lanya">{{opening?'开门中':'开门'}}</view>
                </view>
                <view class="lanyakaimen unopen" wx:else>
                    <view class="iconfont icon-open-door add-btn1"></view>
                    <view class="lanya">开门</view>
                </view>
            </view>
        </view>
        <view class="item-view">
            <view class="detail-info">
                <view class="{{['child-info1',item.pdtime>14?'c6eea27':'cdb4444']}}" wx:if="{{item.Cmd}}">
                    <text>有效期: </text>
                    <text>{{item.day}}</text>
                    <text wx:if="{{item.pdtime<14&&item.pdtime>0}}">（即将到期）</text>
                </view>
                <view class="child-info1 expire" wx:else>{{'有效期: '+item.day+' (已过期)'}}</view>
            </view>
            <view style="width:90px;display:flex;justify-content:center;">
                <text bindtap="__e" class="tx-llmm" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}" data-item="{{item}}" wx:if="{{item.Cmd&&item.DisTempPW===0}}">临时密码</text>
            </view>
        </view>
    </view>
    <view class="yj" wx:if="{{cd==1}}">
        <image src="https://shequpingtai.ximatech.cn/UploadImages/PAArticle/2026-07-27/8efb0c8b018948b4a1a06f94bd1e9fa7.png" style="width:100%;height:100%;"></image>
        <view class="kaimengongeng">
            <view class="item-child PointName">
                <view class="creater-info1">{{item.PointName}}</view>
            </view>
            <image class="lyImg" src="https://shequpingtai.ximatech.cn/UploadImages/PAArticle/2026-07-27/b1f447872a2c4a36b59d52e65294a79c.png"></image>
            <text class="yjkm">一键开门</text>
            <view class="item-view1" style="margin-top:20rpx;">
                <view class="detail-info">
                    <view class="{{['child-info',item.pdtime>14?'cFFF':'cdb4444']}}" style="font-size:40rpx;" wx:if="{{item.Cmd}}">
                        <text>有效期: </text>
                        <text style="margin-left:10rpx;color:#ade1ff;">{{item.day}}</text>
                        <text>天</text>
                        <text wx:if="{{item.pdtime<14&&item.pdtime>0}}">（即将到期）</text>
                    </view>
                    <view class="child-info expire" style="font-size:40rpx;" wx:else>{{'有效期: '+item.day+' (已过期)'}}</view>
                </view>
                <view class="lsmm" wx:if="{{item.Cmd}}">
                    <image bindtap="__e" class="lsma" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}" src="https://shequpingtai.ximatech.cn/UploadImages/PAArticle/2026-07-27/01ac9379fc1f40c1a8f325a83a0a9290.png"></image>
                    <image bindtap="__e" class="lsma" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}" src="https://shequpingtai.ximatech.cn/UploadImages/PAArticle/2026-07-27/0d94d9b4ecd7430999fa4ae82668e4c3.png"></image>
                </view>
            </view>
        </view>
    </view>
    <view catchtouchmove="true" class="modal" wx:if="{{visible}}">
        <view class="mask"></view>
        <view class="gopay_tip">
            <view class="title-view">
                <text class="tip_title">临时密码生成</text>
            </view>
            <view class="llmm-content-view">
                <text class="tip_content1" space="emsp">临时密码为:</text>
                <text class="content_llmm1" selectable="true">{{llmm?llmm:''}}</text>
            </view>
            <view class="tishi">请进入屏幕键盘，输入密码即可开门</view>
            <view class="btn-modal">
                <button bindtap="__e" class="tip_cancel1" data-event-opts="{{[ [ 'tap',[ [ 'cancelLlmm',['$event'] ] ] ] ]}}">确定</button>
                <button bindtap="__e" class="tip_confirm1" data-event-opts="{{[ [ 'tap',[ [ 'copyLlmm',['$event'] ] ] ] ]}}">复制</button>
            </view>
        </view>
    </view>
    <uni-popup animation="{{false}}" bind:__l="__l" class="vue-ref" data-ref="popup" maskClick="{{false}}" type="center" vueId="2fc822c8-1" vueSlots="{{['default']}}">
        <view class="Tk">
            <text class="Instruction">提示</text>
            <textarea class="InstructionTitle" disabled="{{true}}" wx:if="{{OpenType==2||OpenType==1}}">{{Exception}}</textarea>
            <view class="InstructionTitle tac" wx:if="{{OpenType==3}}">蓝牙下发数据失败</view>
            <view class="{{['InstructionTitle',OpenType==3?'tac':'']}}" style="margin-top:50rpx;">您可以使用临时密码开门！</view>
            <view class="anniu">
                <text bindtap="__e" class="but c3" data-event-opts="{{[ [ 'tap',[ [ 'OnColse',['$event'] ] ] ] ]}}">关闭</text>
                <text class="line"></text>
                <text bindtap="__e" class="but c556190" data-event-opts="{{[ [ 'tap',[ [ 'showLlmm',['$event'] ] ] ] ]}}">查看临时密码</text>
            </view>
        </view>
    </uni-popup>
</view>
