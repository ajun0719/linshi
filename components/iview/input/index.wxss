.i-cell {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 16px;
    line-height: 2.4;
    overflow: hidden;
    padding: 15px;
    position: relative
}

.i-cell::after {
    border: solid #e9eaec;
    border-width: 0 0 1px;
    box-sizing: border-box;
    content: "";
    height: 200%;
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    -webkit-transform: scale(.5);
    transform: scale(.5);
    -webkit-transform-origin: 0 0;
    transform-origin: 0 0;
    width: 200%
}

.i-cell-last::after {
    display: none
}

.i-cell-icon {
    margin-right: 5px
}

.i-cell-icon:empty {
    display: none
}

.i-cell-bd {
    -webkit-flex: 1;
    flex: 1
}

.i-cell-text {
    font-size: 16px;
    line-height: 24px
}

.i-cell-desc {
    color: #80848f;
    font-size: 14px;
    line-height: 1.2
}

.i-cell-ft {
    color: #495060;
    position: relative;
    text-align: right
}

.i-cell-access .i-cell-ft {
    padding-right: 13px
}

.i-cell-access .i-cell-ft::after {
    border-color: #dddee1;
    border-style: solid;
    border-width: 2px 2px 0 0;
    content: " ";
    display: inline-block;
    height: 6px;
    position: absolute;
    right: 2px;
    top: 50%;
    -webkit-transform: translateY(-50%) matrix(.71,.71,-.71,.71,0,0);
    transform: translateY(-50%) matrix(.71,.71,-.71,.71,0,0);
    width: 6px
}

.i-input {
    color: #495060;
    padding: 7px
}

.red {
    color: #fa1111
}

.i-input-wrapped {
    background-color: #fff;
    margin: 10px 15px
}

.i-input-wrapped::after {
    border-radius: 4px;
    border-width: 1px;
    left: 0
}

.i-input-error {
    color: #ed3f14
}

.i-input-title {
    color: #495060;
    min-width: 65px;
    padding-right: 10px
}

.notnull-text:after {
    color: red;
    content: " *"
}

.i-input-input {
    -webkit-flex: 1;
    flex: 1;
    font-size: 16px;
    height: auto;
    line-height: 1.6;
    min-height: 30px;
    padding: 4px 0
}

.i-input-placeholder {
    font-size: 16px
}

.i-input-input-right {
    text-align: right
}

.i-input.i-input-wrapped::after {
    display: block
}

.i-input-wrapped.i-input-error::after {
    border-color: #ed3f14
}
