<view class="{{[ 'i-class i-cell i-input '+(error?'i-input-error':'')+' '+(mode==='wrapped'?'i-input-wrapped':'') ]}}">
    <view class="{{[ 'i-cell-hd i-input-title '+(isNotNull?'notnull-text':'') ]}}" wx:if="{{title}}">{{title}}</view>
    <textarea autoHeight="{{true}}" bindblur="__e" bindfocus="__e" bindinput="__e" class="{{[ 'i-input-input i-cell-bd '+(right?'i-input-input-right':'') ]}}" data-event-opts="{{[ [ 'input',[ [ 'handleInputChange',['$event'] ] ] ],[ 'focus',[ [ 'handleInputFocus',['$event'] ] ] ],[ 'blur',[ [ 'handleInputBlur',['$event'] ] ] ] ]}}" data-str="{{strName}}" disabled="{{disabled}}" focus="{{autofocus}}" maxlength="{{maxlength}}" placeholder="{{placeholder}}" placeholderClass="i-input-placeholder" value="{{value}}" wx:if="{{type==='textarea'}}"></textarea>
    <input bindblur="__e" bindfocus="__e" bindinput="__e" class="{{[ 'i-input-input i-cell-bd '+(right?'i-input-input-right':'')+' '+(isRedValue?'red':'') ]}}" data-event-opts="{{[ [ 'input',[ [ 'handleInputChange',['$event'] ] ] ],[ 'focus',[ [ 'handleInputFocus',['$event'] ] ] ],[ 'blur',[ [ 'handleInputBlur',['$event'] ] ] ] ]}}" data-str="{{strName}}" disabled="{{disabled}}" focus="{{autofocus}}" maxlength="{{maxlength}}" placeholder="{{placeholder}}" placeholderClass="i-input-placeholder" type="{{type}}" value="{{value}}" wx:else></input>
</view>
