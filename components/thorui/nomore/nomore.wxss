.tui-loadmore-none {
    font-size: 24rpx;
    line-height: 1.5em;
    margin: 1.5em auto;
    width: 50%
}

.tui-loadmore-none,.tui-nomore {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.tui-nomore {
    height: 100%;
    margin-top: 10rpx;
    padding-bottom: 6rpx;
    position: relative;
    width: 100%
}

.tui-nomore::before {
    border-bottom: 1rpx solid #e5e5e5;
    content: " ";
    left: 0;
    position: absolute;
    top: 18rpx;
    -webkit-transform: scaleY(.5);
    transform: scaleY(.5);
    width: 100%
}

.tui-nomore-text {
    color: #999;
    font-size: 24rpx;
    height: 36rpx;
    line-height: 36rpx;
    padding: 0 18rpx;
    z-index: 1
}

.tui-nomore-dot,.tui-nomore-text {
    position: relative;
    text-align: center
}

.tui-nomore-dot {
    -webkit-display: flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    margin-top: 10rpx;
    padding-bottom: 6rpx
}

.tui-nomore-dot::before {
    border-bottom: 1rpx solid #e5e5e5;
    content: "";
    position: absolute;
    top: 18rpx;
    -webkit-transform: scaleY(.5);
    transform: scaleY(.5);
    width: 360rpx
}

.tui-dot-text {
    color: #e5e5e5;
    font-size: 10px;
    height: 36rpx;
    line-height: 36rpx;
    position: relative;
    text-align: center;
    -webkit-transform: scale(.8);
    transform: scale(.8);
    -webkit-transform-origin: center center;
    transform-origin: center center;
    width: 50rpx;
    z-index: 1
}
