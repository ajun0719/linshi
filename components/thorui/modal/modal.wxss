.tui-modal-box {
    background: #fff;
    box-sizing: border-box;
    left: 50%;
    margin: auto;
    opacity: 0;
    position: fixed;
    top: 50%;
    transition: all .3s ease-in-out;
    visibility: hidden;
    z-index: 9999998
}

.tui-modal-scale {
    -webkit-transform: translate(-50%,-50%) scale(0);
    transform: translate(-50%,-50%) scale(0)
}

.tui-modal-normal {
    -webkit-transform: translate(-50%,-50%) scale(1);
    transform: translate(-50%,-50%) scale(1)
}

.tui-modal-show {
    opacity: 1;
    visibility: visible
}

.tui-modal-mask {
    background: rgba(0,0,0,.6);
    bottom: 0;
    left: 0;
    opacity: 0;
    position: fixed;
    right: 0;
    top: 0;
    transition: all .3s ease-in-out;
    visibility: hidden;
    z-index: 9999996
}

.tui-mask-show {
    opacity: 1;
    visibility: visible
}

.tui-modal-title {
    color: #333;
    font-size: 34rpx;
    font-weight: 700;
    padding-top: 20rpx;
    text-align: center
}

.tui-modal-content {
    color: #999;
    font-size: 28rpx;
    padding-bottom: 60rpx;
    padding-top: 20rpx;
    text-align: center
}

.tui-mtop {
    margin-top: 30rpx
}

.tui-mbtm {
    margin-bottom: 30rpx
}

.tui-modalBtn-box {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    width: 100%
}

.tui-flex-column {
    -webkit-flex-direction: column;
    flex-direction: column
}

.tui-modal-btn {
    border-radius: 10rpx;
    font-size: 24rpx;
    height: 68rpx;
    line-height: 68rpx;
    margin-left: 0;
    margin-right: 0;
    overflow: visible;
    position: relative;
    width: 46%
}

.tui-modal-btn::after {
    border-radius: 20rpx;
    content: "";
    height: 200%;
    left: 0;
    position: absolute;
    top: 0;
    -webkit-transform: scale(.5);
    transform: scale(.5);
    -webkit-transform-origin: 0 0;
    transform-origin: 0 0;
    width: 200%
}

.tui-btn-width {
    width: 80%!important
}

