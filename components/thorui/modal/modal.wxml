<view catchtouchmove="__e" data-event-opts="{{[ [ 'touchmove',[ [ '',['$event'] ] ] ] ]}}">
    <view class="{{['tui-modal-box',fadein||show?'tui-modal-normal':'tui-modal-scale',show?'tui-modal-show':'']}}" style="{{'width:'+width+';'+'padding:'+padding+';'+'border-radius:'+radius+';'}}">
        <view wx:if="{{!custom}}">
            <view class="tui-modal-title" wx:if="{{title}}">{{title}}</view>
            <view class="{{['tui-modal-content',title?'':'tui-mtop']}}" style="{{'color:'+color+';'+'font-size:'+size+'rpx'+';'}}">{{content}}</view>
            <view class="{{['tui-modalBtn-box',$root.g0!=2?'tui-flex-column':'']}}">
                <button bindtap="__e" class="{{['tui-modal-btn','tui-'+(item[$orig].type||'primary')+(item[$orig].plain?'-outline':''),item.g1!=2?'tui-btn-width':'',item.g2>2?'tui-mbtm':'',shape=='circle'?'tui-circle-btn':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'handleClick',['$event'] ] ] ] ]}}" data-index="{{index}}" hoverClass="{{'tui-'+(item[$orig].plain?'outline':item[$orig].type||'primary')+'-hover'}}" wx:for="{{$root.l0}}" wx:key="index">{{item[$orig].text||'确定'}}</button>
            </view>
        </view>
        <view wx:else>
            <slot></slot>
        </view>
    </view>
    <view bindtap="__e" class="{{['tui-modal-mask',show?'tui-mask-show':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'handleClickCancel',['$event'] ] ] ] ]}}"></view>
</view>
