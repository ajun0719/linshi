.tui-actionsheet {
    background: #eaeaec;
    bottom: 0;
    left: 0;
    min-height: 100rpx;
    position: fixed;
    right: 0;
    -webkit-transform: translate3d(0,100%,0);
    transform: translate3d(0,100%,0);
    -webkit-transform-origin: center;
    transform-origin: center;
    transition: all .3s ease-in-out;
    visibility: hidden;
    width: 100%;
    z-index: 9999
}

.tui-actionsheet-show {
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    visibility: visible
}

.tui-tips {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 30rpx 60rpx;
    text-align: center;
    width: 100%
}

.tui-operate-box {
    padding-bottom: 12rpx
}

.tui-actionsheet-btn {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 36rpx;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: relative;
    text-align: center;
    width: 100%
}

.tui-btn-last {
    padding-bottom: env(safe-area-inset-bottom)
}

.tui-actionsheet-divider::before {
    border-top: 1rpx solid #d9d9d9;
    content: "";
    left: 0;
    position: absolute;
    top: 0;
    -webkit-transform: scaleY(.5);
    transform: scaleY(.5);
    width: 100%
}

.tui-actionsheet-cancel {
    color: #1a1a1a;
    padding-bottom: env(safe-area-inset-bottom)
}

.tui-actionsheet-hover {
    background: #f7f7f9
}

.tui-actionsheet-mask {
    background: rgba(0,0,0,.6);
    bottom: 0;
    left: 0;
    opacity: 0;
    position: fixed;
    right: 0;
    top: 0;
    transition: all .3s ease-in-out;
    visibility: hidden;
    z-index: 9996
}

.tui-mask-show {
    opacity: 1;
    visibility: visible
}
