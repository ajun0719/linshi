.main {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%
}

.top {
    height: 90rpx;
    left: 0;
    line-height: 90rpx;
    margin-bottom: 10rpx;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1
}

.isp {
    font-size: 28rpx
}

.order-list-page {
    background: #f0f0f0;
    box-sizing: border-box;
    height: 100%;
    margin-top: 100rpx;
    padding-left: 5rpx;
    padding-right: 20rpx;
    width: 100%
}

.order-list-page .order-item {
    background-color: #fff;
    border-radius: 30rpx;
    height: auto;
    margin: 15rpx 10rpx;
    min-height: 130px;
    width: 100%
}

.order-list-page .order-title {
    -webkit-align-items: center;
    align-items: center;
    color: #666;
    font-size: 28rpx
}

.order-list-page .order-info,.order-list-page .order-title {
    display: -webkit-flex;
    display: flex;
    margin-left: 30rpx;
    padding: 20rpx 30rpx 20rpx 0
}

.order-list-page .order-info {
    position: relative
}

.service_img {
    border-radius: 10rpx;
    height: 100rpx;
    width: 150rpx
}

.order-list-page .order-desc {
    color: #999;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1 1 auto;
    flex: 1 1 auto;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-size: 24rpx;
    -webkit-justify-content: space-around;
    justify-content: space-around;
    margin-left: 24rpx;
    padding: 20rpx 0
}

.order-list-page .movie-name {
    color: #333;
    font-size: 30rpx;
    width: 80%
}

.num {
    color: #ec2c2c;
    font-size: 26rpx
}

.order-list-page .order-more {
    color: #6d6d6d;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 20rpx 30rpx
}

.line-ellipsis {
    margin-top: 5rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap
}

.coent_list {
    background-color: #fff;
    border-bottom-left-radius: 30rpx;
    border-bottom-right-radius: 30rpx;
    height: 100rpx;
    position: relative;
    width: 100%
}

.no-data-view {
    left: 50%;
    position: fixed;
    top: 25%;
    -webkit-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%);
    z-index: 1000
}

.itemTop {
    border-bottom: #e7e8e9
}

.itemTop,.nameclass {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.pay-btn {
    background-color: #e64340;
    color: #fff;
    display: inline-block;
    font-size: 25rpx;
    height: 60rpx;
    line-height: 56rpx;
    margin-right: 5rpx;
    position: absolute;
    right: 30rpx;
    text-align: center;
    top: 10%;
    width: 170rpx
}

.orderStatus,.pay-btn {
    -webkit-align-items: center;
    align-items: center
}

.orderStatus {
    color: #f01717;
    display: -webkit-flex;
    display: flex;
    font-size: 30rpx;
    padding-right: 15rpx
}
