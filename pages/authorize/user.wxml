<view>
    <view class="authorize-view">
        <view class="userinfo">
            <image class="userinfo-avatar" mode="cover" src="/static/images/maiyun.jpg"></image>
            <text class="userinfo-nickname">迈云通</text>
        </view>
        <view class="usermotto">
            <text class="user-motto">申请获得你的公开信息（昵称、头像等）</text>
        </view>
    </view>
    <view style="margin:30rpx;">
        <button bindtap="__e" class="btn-primary" data-event-opts="{{[ [ 'tap',[ [ 'getUserInfoClick',['$event'] ] ] ] ]}}" wx:if="{{!preventFlag}}">获取微信信息</button>
        <button class="btn-primary" wx:else>获取微信信息</button>
    </view>
</view>
