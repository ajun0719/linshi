<view>
    <view class="container-loading" wx:if="{{isLoading}}">
        <view class="userinfo">
            <image class="userinfo-avatar" mode="cover" src="/static/images/maiyun.jpg"></image>
            <text class="userinfo-nickname">迈云通</text>
        </view>
        <view class="usermotto">
            <text class="user-motto">正在登录......</text>
        </view>
    </view>
    <view class="login_class" wx:else>
        <view class="logo_login">
            <image class="logo-img" src="/static/images/maiyun.jpg"></image>
        </view>
        <view class="input-view">
            <view class="input_phone_view">
                <text class="label">手机号:</text>
                <input bindinput="__e" class="input-code" data-event-opts="{{[ [ 'input',[ [ 'userNameInput',['$event'] ] ] ] ]}}" maxlength="11" mode="normal" placeholder="请输入手机号码" title="手机号：" type="number"></input>
            </view>
            <view class="input_code-view">
                <view class="sms-input">
                    <text class="label">验证码:</text>
                    <input bindinput="__e" class="input-code" data-event-opts="{{[ [ 'input',[ [ 'codeInput',['$event'] ] ] ] ]}}" maxlength="6" placeholder="请输入验证码" title="验证码 ：" type="text" value="{{smsCode}}"></input>
                </view>
                <view class="button-small-wrap">
                    <button bindtap="__e" class="{{[isSendCode?'btn-code-send':'btn-code']}}" data-event-opts="{{[ [ 'tap',[ [ 'login_GetCode',['$event'] ] ] ] ]}}" disabled="{{isSendCode}}" hoverClass="{{isSendCode?'':'btn-hover-clss'}}">{{isSendCode?second+'秒后重新发送':codeText}}</button>
                </view>
            </view>
        </view>
        <view class="tip-view">
            <text class="consent_agreement">温馨提示：若手机号尚未注册，将为你创建账号</text>
        </view>
        <view class="register_footer">
            <checkbox-group bindchange="__e" data-event-opts="{{[ [ 'change',[ [ 'chooseXy',['$event'] ] ] ] ]}}">
                <checkbox>已阅读同意</checkbox>
            </checkbox-group>
            <navigator class="xy" openType="navigate" url="/pages/xieyi/xieyi">《用户服务协议》</navigator>
        </view>
        <button bindtap="__e" class="btn_info btn-primary" data-event-opts="{{[ [ 'tap',[ [ 'login_Submit',['$event'] ] ] ] ]}}">快速登录</button>
    </view>
</view>
