page {
    background: #fff
}

wx-swiper {
    height: 350rpx;
    padding: 0 20rpx;
    width: 100%
}

wx-swiper .swiper-image {
    border-radius: 10rpx;
    height: 100%;
    width: 100%
}

.fixed-container {
    margin: 20rpx 30rpx
}

.fixed-head1,.fixed-head2 {
    -webkit-align-content: center;
    align-content: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.fixed-head2 {
    -webkit-align-items: flex-end;
    align-items: flex-end
}

.fixed-head-left {
    -webkit-align-items: center;
    align-items: center
}

.fixed-main-title {
    color: #313131;
    font-size: 33rpx
}

.fixed-head-right {
    -webkit-align-items: center;
    align-items: center
}

.fixed-link,.fixed-sub-title {
    color: #8d8d8d;
    font-size: 27rpx
}

.fixed-link {
    margin-right: 14rpx
}

.fixed-list {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.fixed-arrow {
    resize-mode: contain;
    -webkit-align-self: center;
    align-self: center;
    height: 28rpx;
    width: 16rpx
}

.fixed-product2 {
    background-color: #fff;
    border-radius: 8rpx;
    box-shadow: 0 0 20rpx 10rpx #f2f2f2;
    -webkit-flex-direction: column;
    flex-direction: column;
    width: 333.3rpx
}

.fixed-image2 {
    border-top-left-radius: 8rpx;
    border-top-right-radius: 8rpx;
    height: 190rpx;
    margin-bottom: 8rpx;
    width: 100%
}

.fixed-product3 {
    background-color: #fff;
    border-radius: 8rpx;
    box-shadow: 0 0 10rpx 10rpx #f2f2f2;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-top: 25rpx;
    width: 217rpx
}

.fixed-image3 {
    border-top-left-radius: 8rpx;
    border-top-right-radius: 8rpx;
    height: 217rpx;
    margin-bottom: 8rpx;
    width: 217rpx
}

.fixed-title {
    color: #1a1a1a;
    font-size: 27rpx;
    margin-left: 18rpx
}

.fixed-subtitle {
    color: #8d8d8d;
    font-size: 21rpx;
    margin-bottom: 8.1rpx;
    margin-left: 18rpx
}
