<view class="page">
    <view class="obj">
        <view class="name_value">
            <view class="name">设备编号:</view>
            <view class="value">{{SmokeObj.DeviceCode}}</view>
        </view>
        <view class="title_value">
            <view class="title">设备名称:</view>
            <view class="value address">{{SmokeObj.DeviceName}}</view>
        </view>
        <view class="title_value">
            <view class="title">设备类型:</view>
            <view class="value">{{SmokeObj.DeviceType}}</view>
        </view>
    </view>
    <view class="obj">
        <view class="name_value">
            <view class="name">运营商:</view>
            <view class="value">{{SmokeObj.IOTOperator}}</view>
        </view>
        <view class="title_value">
            <view class="title">设备IMEI:</view>
            <view class="value">{{SmokeObj.IMEI}}</view>
        </view>
        <view class="title_value">
            <view class="title">设备MSISDN :</view>
            <view class="value">{{SmokeObj.MSISDN}}</view>
        </view>
    </view>
    <view class="obj">
        <view class="name_value">
            <view class="name">房屋地址:</view>
            <view class="value address">{{SmokeObj.buildingall}}</view>
        </view>
        <view class="title_value">
            <view class="title">通信时间:</view>
            <view class="value address">{{SmokeObj.ReqTime}}</view>
        </view>
    </view>
    <view class="obj" wx:if="{{$root.g0>0}}">
        <view class="imgList">
            <image bindtap="__e" class="img" data-event-opts="{{[ [ 'tap',[ [ 'OnPreview',['$event'] ] ] ] ]}}" data-url="{{item.ImgPath}}" mode="aspectFill" src="{{item.ImgPath}}" wx:for="{{imgList}}" wx:key="ID"></image>
        </view>
    </view>
</view>
