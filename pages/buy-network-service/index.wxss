.page {
    overflow-x: hidden
}

.serviceDataTip {
    background: #fff;
    color: #3a3a3a;
    font-size: 30rpx;
    font-weight: 700;
    margin-top: 10rpx;
    padding-left: 10rpx
}

.service-content {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

.content-text {
    color: #495060;
    margin: 16rpx
}

.bottom {
    background: #fff;
    border-top: 1px solid #ece4e4;
    bottom: 0;
    font-size: 24rpx;
    height: 80rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    position: fixed;
    z-index: 1
}

.adcolumnMessage,.bottom {
    display: -webkit-flex;
    display: flex;
    width: 100%
}

.adcolumnMessage {
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-top: 20rpx
}

.adcolumnMessage,.service-manager,.title {
    background-color: #fff
}

.title {
    border-top: 1px solid #eee;
    padding: 30rpx 30rpx 30rpx 0
}

.titleTip {
    color: #3a3a3a;
    font-size: 30rpx;
    font-weight: 700;
    padding: 30rpx 0 25rpx 10rpx
}

.btn-save-class {
    margin-top: 30rpx;
    padding: 20rpx
}

.content_name {
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1px solid #f5f5f5;
    color: #495060;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    font-size: 32rpx;
    height: 100rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 0rpx 15rpx
}
