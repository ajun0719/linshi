<view class="uni-collapse-item">
    <view bindtap="__e" class="{{['uni-collapse-item__title',isOpen&&titleBorder==='auto'?'is-open':'',titleBorder!=='none'?'uni-collapse-item-border':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onClick',[!isOpen] ] ] ] ]}}" wx:if="{{showArrow}}">
        <view class="uni-collapse-item__title-wrap">
            <slot name="title" wx:if="{{$slots.title}}"></slot>
            <view class="{{['uni-collapse-item__title-box',disabled?'is-disabled':'']}}" wx:else>is--transition<image class="uni-collapse-item__title-img" src="{{thumb}}" wx:if="{{thumb}}"></image>
                <text class="uni-collapse-item__title-text">{{title}}</text>
            </view>
        </view>
        <view class="{{['uni-collapse-item__title-arrow',isOpen?'uni-collapse-item__title-arrow-active':'',showAnimation===true?'uni-collapse-item--animation':'']}}">
            <uni-icons bind:__l="__l" color="{{disabled?'#ddd':'#bbb'}}" size="14" type="bottom" vueId="4164e95c-1"></uni-icons>
        </view>
    </view>
    <view class="{{['uni-collapse-item__wrap',showAnimation?'is--transition':'']}}" style="{{'height:'+(isOpen?height:0)+'px'+';'}}">
        <view class="{{['uni-collapse-item__wrap-content','vue-ref',isheight?'open':'',border&&isOpen?'uni-collapse-item--border':'']}}" data-ref="collapse--hook" id="{{elId}}">
            <slot></slot>
        </view>
    </view>
</view>
