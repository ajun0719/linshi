    </view>
    <view class="uni-noticebar-close uni-cursor-point data-v-a6c0e920" wx:if="{{isShowClose}}">
        <uni-icons bind:__l="__l" bind:click="__e" class="data-v-a6c0e920" color="{{color}}" data-event-opts="{{[ [ '^click',[ ['close'] ] ] ]}}" size="{{fontSize*1.1}}" type="closeempty" vueId="3b16ced1-3"></uni-icons>
